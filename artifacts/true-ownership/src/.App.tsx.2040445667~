                    style={{ padding:"14px 16px", background:"rgba(255,255,255,.03)", border:`1px solid ${borderCol}30`, borderRadius:10, cursor: pinned ? "default" : "pointer", transition:"all .15s ease", opacity: pinned ? 0.7 : 1 }}
