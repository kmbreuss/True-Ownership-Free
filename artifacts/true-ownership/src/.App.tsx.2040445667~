              </select>
              <button onClick={addAct}
                style={{ padding:"6px 14px", background:"var(--warm)", color:"var(--bg)", border:"none", borderRadius:6, fontFamily:"var(--sans)", fontSize:12, fontWeight:700, cursor:"pointer" }}>
