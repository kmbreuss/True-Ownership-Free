                          </div>
                          <div style={{ fontFamily:"var(--serif)", fontStyle:"italic", fontSize:13, color:"var(--text2)", lineHeight:1.7 }}>{map[`val_${i}_feedback`]}</div>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              );
            })()}
          </div>
        );
      })}
